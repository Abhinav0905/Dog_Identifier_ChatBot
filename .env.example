# AI provider selection: "openai" (default) or "claude"
MODEL_PROVIDER=openai

# OpenAI API key for vision, chat, and admin analytics
OPENAI_API_KEY=sk-your-openai-key-here

# Optional model overrides
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=
OPENAI_CHAT_MODEL=gpt-5.4
OPENAI_ADMIN_MODEL=
OPENAI_WEB_SEARCH_MODEL=gpt-5.4-mini
OPENAI_GEOGRAPHY_MODEL=gpt-5.4-mini
OPENAI_QUERY_ROUTER_MODEL=gpt-5.4-mini
OPENAI_ROUTING_TIMEOUT_SECONDS=12
OPENAI_VISION_TIMEOUT_SECONDS=45

# RAG scraping + Pinecone hybrid search
DAR_SCRAPE_BASE_URL=https://dharamsalaanimalrescue.org/
DAR_SCRAPE_MAX_PAGES=80
DAR_CONTACT_URL=https://dharamsalaanimalrescue.org/contact/
RAG_VECTOR_BACKEND=chroma
RAG_SQLITE_EMBEDDINGS=false
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_DENSE_DIMENSION=384
RAG_HYBRID_ALPHA=0.65
RAG_SPARSE_DIMENSION=262144
CHROMA_PERSIST_DIR=
CHROMA_COLLECTION_NAME=dar-rag
CHROMA_HNSW_SPACE=cosine
CHROMA_HNSW_CONSTRUCTION_EF=200
CHROMA_HNSW_SEARCH_EF=100
CHROMA_HNSW_M=16
PINECONE_API_KEY=
PINECONE_INDEX_NAME=dar-rag-hybrid
PINECONE_NAMESPACE=dharamsala-animal-rescue
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Anthropic API key — required when MODEL_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API key — required when MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here

# Alert webhook URL (optional, logs to console if not set)
ALERT_WEBHOOK_URL=

# Slack webhook URL (optional)
SLACK_WEBHOOK_URL=

# Admin password for analytics endpoints
ADMIN_PASSWORD=

# Public rescue contact shown in guidance responses
DAR_PHONE_NUMBER=

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Keep enabled on every public deployment. Tests may disable it explicitly.
TWILIO_VALIDATE_SIGNATURES=true
# Example: https://askdorjee.dharamsalaanimalrescue.org
TWILIO_WEBHOOK_BASE_URL=
# Demo-only: WhatsApp usually strips EXIF GPS from sent photos, so inject a
# Dharamsala test coordinate when no WhatsApp location pin is available.
WHATSAPP_DEMO_LOCATION_FALLBACK=false
WHATSAPP_DEMO_LAT=32.2196
WHATSAPP_DEMO_LNG=76.3234

# Feature flags
# Legacy setting, ignored: general photo assessment no longer requires GPS.
# Recording a local rescue incident still requires an eligible location.
STRICT_LOCATION_GATE=true
INDIA_ONLY_SCOPE_ENABLED=true
MAX_CHAT_MESSAGE_CHARS=6000
PUBLIC_REQUESTS_PER_MINUTE=30
CHAT_TURN_TIMEOUT_SECONDS=90
WHATSAPP_LOCATION_TTL_MINUTES=60
DOG_WEB_SEARCH_ENABLED=true
DOG_WEB_SEARCH_MAX_RESULTS=5
DOG_WEB_SEARCH_MAX_TOOL_CALLS=8
DOG_WEB_SEARCH_TOTAL_TIMEOUT_SECONDS=60
DOG_WEB_SEARCH_OPENAI_TIMEOUT_SECONDS=35
DOG_WEB_PAGE_VERIFY_TIMEOUT_SECONDS=6
DOG_WEB_PAGE_VERIFY_MAX_BYTES=1000000
# PDF directories can be larger than HTML; keep independent bounded parsing limits.
DOG_WEB_PDF_VERIFY_MAX_BYTES=8388608
DOG_WEB_PDF_VERIFY_MAX_PAGES=60
DOG_WEB_PDF_VERIFY_MAX_CHARS=150000
DOG_WEB_SEARCH_CACHE_ENABLED=true
DOG_WEB_SEARCH_CACHE_HOURS=24
DOG_WEB_SEARCH_STALE_CACHE_HOURS=168
# Text place resolution. Set the LocationIQ token only on the server. When it
# is present LocationIQ is the primary provider; otherwise development falls
# back to public Nominatim.
PLACE_GEOCODING_ENABLED=true
# Leave blank for automatic selection, or set locationiq/nominatim explicitly.
PLACE_GEOCODER_PROVIDER=
LOCATIONIQ_API_KEY=
LOCATIONIQ_SEARCH_URL=https://us1.locationiq.com/v1/search
LOCATIONIQ_AUTOCOMPLETE_URL=https://api.locationiq.com/v1/autocomplete
LOCATIONIQ_CACHE_DAYS=2
PLACE_FUZZY_GEOCODING_ENABLED=true
PLACE_FUZZY_GEOCODER_URL=https://photon.komoot.io/api/
PLACE_FUZZY_MIN_SCORE=0.84
PLACE_LOCALITY_HINT_MAX_KM=120
INDIA_POSTAL_LOOKUP_ENABLED=true
INDIA_POSTAL_LOOKUP_URL=https://api.postalpincode.in/postoffice/{place}
INDIA_POSTAL_LOOKUP_TIMEOUT_SECONDS=8
PLACE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
PLACE_GEOCODER_USER_AGENT=AskDorjee/1.0 (https://dharamsalaanimalrescue.org/)
PLACE_GEOCODER_TIMEOUT_SECONDS=10
PLACE_GEOCODER_CACHE_DAYS=30
# Anonymous browser conversations use a server-owned HttpOnly cookie. The
# browser stores only the non-secret active conversation ID.
CONVERSATION_GUEST_TTL_HOURS=24
CONVERSATION_HISTORY_LIMIT=100
CONVERSATION_COOKIE_NAME=askdorjee_guest
# Keep true behind HTTPS. Set false only for plain-HTTP local development.
CONVERSATION_COOKIE_SECURE=true
# Keep structured case context aligned with the guest-conversation lifetime.
CASE_LOCATION_TTL_MINUTES=1440
# An explicit parent city must remain geographically plausible for the incident.
SERVICE_CITY_MAX_DISTANCE_KM=60
# Buffer around Deb's named service-area route checkpoints, in km.
DHARAMSALA_SERVICE_POINT_RADIUS_KM=3
# Legacy fallback radius setting; route polygon/checkpoints are the active gate.
DHARAMSALA_REGION_RADIUS_KM=1000

# Server config
HOST=0.0.0.0
PORT=8000
MAX_IMAGE_SIZE_MB=100
VISION_IMAGE_MAX_DIMENSION=2048
VISION_IMAGE_JPEG_QUALITY=88

# Optional persistent paths (useful for Docker/EC2)
DB_PATH=
STORAGE_DIR=
